{
  "version": 2,
  "cleanUrls": true,
  "regions": ["gru1"],
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/config", "destination": "/api/sessao?rota=config" },
    { "source": "/api/aquecer", "destination": "/api/sessao?rota=aquecer" },
    { "source": "/api/me", "destination": "/api/sessao?rota=me" },
    { "source": "/api/health", "destination": "/api/sessao?rota=health" },
    { "source": "/api/master", "destination": "/api/gerencial?rota=master" },
    { "source": "/api/overview", "destination": "/api/gerencial?rota=overview" },
    { "source": "/api/visits", "destination": "/api/gerencial?rota=visits" },
    { "source": "/api/turnover", "destination": "/api/gerencial?rota=turnover" },
    { "source": "/api/consistency", "destination": "/api/gerencial?rota=consistency" },
    { "source": "/api/economics", "destination": "/api/gerencial?rota=economics" },
    { "source": "/api/production", "destination": "/api/producao?rota=production" },
    { "source": "/api/territory", "destination": "/api/producao?rota=territory" },
    { "source": "/api/safra", "destination": "/api/producao?rota=safra" }
  ],
  "headers": [
    {
      "source": "/api/(master|overview|visits|turnover|consistency|economics|production|territory|safra)",
      "headers": [
        { "key": "Cache-Control", "value": "private, max-age=300" },
        { "key": "Vary", "value": "Authorization" }
      ]
    },
    {
      "source": "/api/(me|config|aquecer|health|admin-usuarios)",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    }
  ]
}
